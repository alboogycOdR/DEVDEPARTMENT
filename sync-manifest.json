  ],
  "merge_special": {
    "CLAUDE.md": {
      "strategy": "marker_section",
      "marker": "# CLAUDE.md \u2014 Orchestrator Briefing (ORCH)",
      "markers": [
        "# CLAUDE.md \u2014 Orchestrator Briefing (ORCH)",
        "## Multi-Agent Orchestration \u2014 DEVDEPARTMENT (ORCH)"
      ],
      "preserve_after": [
        "## Builder territory mapping for THIS project",
        "### Builder territory mapping for THIS project"
      ],
      "comment": "Everything above the project's marker is its own (name, stack, conventions) and is preserved; the pack's content refreshes the section BELOW that heading line; anything from a preserve_after sentinel onward is the project's own again and is preserved. TWO markers because onboarding produces two legal shapes (onboard.md STEP 4): a project with NO CLAUDE.md gets the pack's file verbatim (H1 marker); a project WITH one gets the section appended under the H2 marker -- the common case, which the single-marker version could never sync (found live on oikonomos 2026-08-15). preserve_after exists because STEP 4 also appends the project's REAL territory map AFTER the pack section; without it, the first successful sync would silently delete that map. Verified against both real shapes -- see docs/SYNC.md 'Verifying merge_special markers'."
    },
    "autopilot.json": {
      "strategy": "add_only_keys",
      "comment": "New top-level keys and new nested keys from the pack template are ADDED; every existing value in the project's copy is preserved (the project's tuning -- interval, builders, control.mode, allowlists -- is its own)."
    },
    ".claude/settings.json": {
      "strategy": "manual_only",
      "comment": "Hook wiring is the most sensitive file (may contain the project's own non-DEVDEPARTMENT hooks). Sync only REPORTS if the pack's hooks.json declares hooks missing from it; a human or onboarding session applies the change."
    },
    ".codex/config.toml": {
      "strategy": "manual_only",
      "comment": "Same posture: report drift, never auto-edit."
    }
  }
}
